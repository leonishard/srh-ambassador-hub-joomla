<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="SRH\Component\Ambassadorhub\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_AMBASSADORHUB_FILTER_SEARCH_LABEL"
			description="COM_AMBASSADORHUB_FILTER_SEARCH_EVENT_DESC"
			inputmode="search"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="status"
			type="list"
			label="COM_AMBASSADORHUB_FIELD_STATUS_LABEL"
			class="js-select-submit-on-change"
			validate="options"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="pending">COM_AMBASSADORHUB_STATUS_PENDING</option>
			<option value="approved">COM_AMBASSADORHUB_STATUS_APPROVED</option>
			<option value="rejected">COM_AMBASSADORHUB_STATUS_REJECTED</option>
		</field>
		<field
			name="group_id"
			type="group"
			label="COM_AMBASSADORHUB_FIELD_GROUP_LABEL"
			class="js-select-submit-on-change"
			>
			<option value="">COM_AMBASSADORHUB_FIELD_GROUP_SELECT</option>
		</field>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.event_date DESC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.event_date ASC">COM_AMBASSADORHUB_FIELD_EVENT_DATE_LABEL_ASC</option>
			<option value="a.event_date DESC">COM_AMBASSADORHUB_FIELD_EVENT_DATE_LABEL_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
