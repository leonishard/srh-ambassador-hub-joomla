<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="SRH\Component\Ambassadorhub\Administrator\Field">
	<fieldset name="group">

		<field
			name="id"
			type="text"
			label="JGLOBAL_FIELD_ID_LABEL"
			default="0"
			class="readonly"
			readonly="true"
		/>

		<field
			name="name"
			type="text"
			label="COM_AMBASSADORHUB_FIELD_NAME_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="alias"
			type="text"
			label="JFIELD_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			hint="JFIELD_ALIAS_PLACEHOLDER"
		/>

		<field
			name="category"
			type="text"
			label="COM_AMBASSADORHUB_FIELD_CATEGORY_LABEL"
			size="30"
		/>

		<field
			name="state"
			type="list"
			label="JSTATUS"
			default="1"
			class="form-select-color-state"
			validate="options"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="manager_student_id"
			type="student"
			label="COM_AMBASSADORHUB_FIELD_MANAGER_LABEL"
			description="COM_AMBASSADORHUB_FIELD_MANAGER_DESC"
			>
			<option value="">COM_AMBASSADORHUB_FIELD_MANAGER_NONE</option>
		</field>

		<field
			name="cover_image"
			type="media"
			label="COM_AMBASSADORHUB_FIELD_COVER_IMAGE_LABEL"
		/>

		<field
			name="profile_picture"
			type="media"
			label="COM_AMBASSADORHUB_FIELD_PROFILE_PICTURE_LABEL"
		/>

		<field
			name="description"
			type="textarea"
			label="COM_AMBASSADORHUB_FIELD_DESCRIPTION_LABEL"
			rows="8"
		/>

		<field
			name="created"
			type="calendar"
			label="JGLOBAL_FIELD_CREATED_LABEL"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
			readonly="true"
		/>

	</fieldset>
</form>
